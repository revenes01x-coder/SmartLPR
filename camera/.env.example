# ============================================================
# SmartLPR camera — ตัวอย่างไฟล์ตั้งค่า
# วิธีใช้: คัดลอกเป็น camera/.env แล้วแทนค่า <...> ด้วยค่าจริง
#   cp camera/.env.example camera/.env
# ค่าที่ต้อง "ตรงกับ backend/.env": CAPTURE_EVENT_SECRET, DB_USER, DB_PASSWORD, DB_NAME, CAPTURES_SAVE_DIR
# ============================================================

# ---- ส่งผลการตรวจจับไปให้ backend ----
CAPTURE_EVENT_SECRET=<ค่าเดียวกับ backend/.env>
# ชี้ไปที่ชื่อ service "backend" ผ่าน network กลาง smartlpr_web (ไม่ผ่าน nginx)
CAPTURE_EVENT_WEBHOOK_URL=http://backend:8000/capture-event

# ---- ฐานข้อมูล (camera อ่านอย่างเดียว: รายชื่อกล้องที่ต้องเฝ้า) ----
# camera/docker-compose.yml ใช้ 3 ค่านี้ประกอบ DATABASE_URL ให้เอง
DB_USER=smartlpr_user
DB_PASSWORD=<ค่าเดียวกับ backend/.env>
DB_NAME=smartlpr_db
# ต้องมีเสมอ (camera/config.py บังคับ) — ตอนรันด้วย Docker ถูกกำหนดทับให้อัตโนมัติ
DATABASE_URL=postgresql+asyncpg://smartlpr_user:<รหัสผ่านฐานข้อมูล>@db:5432/smartlpr_db

# ---- ป้องกัน SSRF: อนุญาตกล้องที่อยู่ใน IP ภายในหรือไม่ ----
ALLOW_PRIVATE_IP=false

# ---- โมเดล AI (path ภายในคอนเทนเนอร์ — โค้ดของ camera/app ถูกวางไว้ที่ /app) ----
PLATE_DETECTION_REPO_PATH=/app/plate_detection_repo
PLATE_OCR_MODEL_PATH=/app/models/ocr/thai_platev1.pth
PLATE_OCR_CHAR_FILE=/app/thai_plate_chars.txt
PLATE_YOLO_MODEL_PATH=/app/models/yolo/best.pt
CAR_DETECTOR_MODEL_PATH=/app/models/detector/yolo11n.pt
CAR_COLOR_MODEL_PATH=/app/models/color/car_color_model.h5
CAR_COLOR_CLASSNAMES_PATH=/app/models/color/class_names.json

# ---- รูปภาพ ----
# โฟลเดอร์เก็บรูปที่กล้องจับได้ (ต้องตรงกับ backend/.env)
CAPTURES_SAVE_DIR=captures

# ---- ค่าเสริม ----
# จำนวนเฟรมต่อวินาทีที่ส่งเข้า AI
# CAMERA_DETECTION_FPS=5.0
